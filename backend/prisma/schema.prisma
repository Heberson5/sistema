// Schema do Sistema de Gestão Funerária
// Modelagem inspirada nas tabelas do iVertex (planilha de referência), reestruturada
// e simplificada para uma aplicação web nova (schema novo, sem migração de dados legados).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// AUTENTICAÇÃO / USUÁRIOS
// ============================================================

enum PapelUsuario {
  ADMIN
  GERENTE
  ATENDENTE
  VENDEDOR
  FINANCEIRO
}

model Usuario {
  id        String       @id @default(cuid())
  nome      String
  email     String       @unique
  senhaHash String
  papel     PapelUsuario @default(ATENDENTE)
  ativo     Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  vendas       Venda[]       @relation("VendedorVendas")
  atendimentos Atendimento[] @relation("AtendenteAtendimentos")

  @@map("usuarios")
}

// ============================================================
// PESSOAS (entidade universal: cliente, titular, beneficiário, responsável, falecido)
// ============================================================

enum TipoPessoa {
  FISICA
  JURIDICA
}

model Pessoa {
  id             String     @id @default(cuid())
  tipo           TipoPessoa @default(FISICA)
  nome           String
  cpfCnpj        String?    @unique
  rg             String?
  dataNascimento DateTime?
  sexo           String?
  email          String?
  telefone       String?
  celular        String?
  cep            String?
  logradouro     String?
  numero         String?
  complemento    String?
  bairro         String?
  cidade         String?
  uf             String?
  observacoes    String?
  ativo          Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  contratosPlano    ContratoPlano[]             @relation("TitularContratos")
  comoBeneficiario  ContratoPlanoBeneficiario[]
  vendas            Venda[]                     @relation("ClienteVendas")
  locacoes          Locacao[]                   @relation("ClienteLocacoes")
  obitosResponsavel Obito[]                     @relation("ResponsavelObitos")
  atendimentos      Atendimento[]               @relation("ClienteAtendimentos")
  guiasMedicas      GuiaMedica[]                @relation("BeneficiarioGuias")

  @@map("pessoas")
}

// ============================================================
// MÓDULO: PLANOS DE ASSISTÊNCIA FUNERÁRIA
// ============================================================

enum TipoCobrancaPlano {
  MENSAL
  ANUAL
}

model Plano {
  id               String            @id @default(cuid())
  nome             String
  descricao        String?
  tipoCobranca     TipoCobrancaPlano @default(MENSAL)
  valorMensalidade Decimal           @db.Decimal(12, 2)
  carenciaDias     Int               @default(0)
  ativo            Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  coberturas PlanoCobertura[]
  contratos  ContratoPlano[]

  @@map("planos")
}

model PlanoCobertura {
  id          String   @id @default(cuid())
  planoId     String
  descricao   String
  limiteValor Decimal? @db.Decimal(12, 2)
  limiteQtd   Int?

  plano Plano @relation(fields: [planoId], references: [id], onDelete: Cascade)

  @@map("plano_coberturas")
}

enum StatusContratoPlano {
  ATIVO
  SUSPENSO
  CANCELADO
  QUITADO
}

model ContratoPlano {
  id               String              @id @default(cuid())
  numero           String              @unique
  planoId          String
  titularId        String
  dataAdesao       DateTime            @default(now())
  diaVencimento    Int                 @default(10)
  valorMensalidade Decimal             @db.Decimal(12, 2)
  status           StatusContratoPlano @default(ATIVO)
  observacoes      String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  plano         Plano                       @relation(fields: [planoId], references: [id])
  titular       Pessoa                      @relation("TitularContratos", fields: [titularId], references: [id])
  beneficiarios ContratoPlanoBeneficiario[]
  parcelas      ContratoPlanoParcela[]
  guiasMedicas  GuiaMedica[]

  @@map("contratos_plano")
}

model ContratoPlanoBeneficiario {
  id              String   @id @default(cuid())
  contratoPlanoId String
  pessoaId        String
  parentesco      String?
  dataInclusao    DateTime @default(now())
  ativo           Boolean  @default(true)

  contratoPlano ContratoPlano @relation(fields: [contratoPlanoId], references: [id], onDelete: Cascade)
  pessoa        Pessoa        @relation(fields: [pessoaId], references: [id])

  @@map("contrato_plano_beneficiarios")
}

enum StatusParcela {
  PENDENTE
  PAGO
  ATRASADO
  CANCELADO
}

model ContratoPlanoParcela {
  id              String        @id @default(cuid())
  contratoPlanoId String
  numeroParcela   Int
  competencia     DateTime
  valor           Decimal       @db.Decimal(12, 2)
  vencimento      DateTime
  dataPagamento   DateTime?
  formaPagamento  String?
  status          StatusParcela @default(PENDENTE)

  contratoPlano ContratoPlano @relation(fields: [contratoPlanoId], references: [id], onDelete: Cascade)

  @@map("contrato_plano_parcelas")
}

// ============================================================
// MÓDULO: CEMITÉRIO (JAZIGOS, COLUMBÁRIOS, OSSUÁRIOS)
// ============================================================

enum StatusUnidade {
  DISPONIVEL
  RESERVADO
  VENDIDO
  LOCADO
  OCUPADO
  BLOQUEADO
}

model Cemiterio {
  id         String   @id @default(cuid())
  nome       String
  cnpj       String?
  telefone   String?
  cep        String?
  logradouro String?
  numero     String?
  bairro     String?
  cidade     String?
  uf         String?
  ativo      Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  quadras Quadra[]
  alas    Ala[]
  blocos  Bloco[]

  @@map("cemiterios")
}

model Quadra {
  id          String  @id @default(cuid())
  cemiterioId String
  codigo      String
  descricao   String?

  cemiterio Cemiterio @relation(fields: [cemiterioId], references: [id], onDelete: Cascade)
  alamedas  Alameda[]

  @@map("quadras")
}

model Alameda {
  id        String  @id @default(cuid())
  quadraId  String
  codigo    String
  descricao String?

  quadra  Quadra   @relation(fields: [quadraId], references: [id], onDelete: Cascade)
  jazigos Jazigo[]

  @@map("alamedas")
}

model TipoJazigo {
  id                String  @id @default(cuid())
  nome              String
  capacidadeGavetas Int     @default(1)
  valorBase         Decimal @db.Decimal(12, 2)

  jazigos Jazigo[]

  @@map("tipos_jazigo")
}

model Jazigo {
  id           String        @id @default(cuid())
  alamedaId    String
  tipoJazigoId String
  numero       String
  status       StatusUnidade @default(DISPONIVEL)
  valor        Decimal       @db.Decimal(12, 2)
  observacoes  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  alameda    Alameda     @relation(fields: [alamedaId], references: [id])
  tipoJazigo TipoJazigo  @relation(fields: [tipoJazigoId], references: [id])
  vendaItens VendaItem[]
  locacoes   Locacao[]

  @@unique([alamedaId, numero])
  @@map("jazigos")
}

model Ala {
  id          String  @id @default(cuid())
  cemiterioId String
  codigo      String
  descricao   String?

  cemiterio   Cemiterio    @relation(fields: [cemiterioId], references: [id], onDelete: Cascade)
  columbarios Columbario[]

  @@map("alas")
}

model TipoColumbario {
  id              String  @id @default(cuid())
  nome            String
  capacidadeUrnas Int     @default(1)
  valorBase       Decimal @db.Decimal(12, 2)

  columbarios Columbario[]

  @@map("tipos_columbario")
}

model Columbario {
  id               String        @id @default(cuid())
  alaId            String
  tipoColumbarioId String
  numero           String
  status           StatusUnidade @default(DISPONIVEL)
  valor            Decimal       @db.Decimal(12, 2)
  observacoes      String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  ala            Ala            @relation(fields: [alaId], references: [id])
  tipoColumbario TipoColumbario @relation(fields: [tipoColumbarioId], references: [id])
  vendaItens     VendaItem[]

  @@unique([alaId, numero])
  @@map("columbarios")
}

model Bloco {
  id          String  @id @default(cuid())
  cemiterioId String
  codigo      String
  descricao   String?

  cemiterio Cemiterio  @relation(fields: [cemiterioId], references: [id], onDelete: Cascade)
  ossuarios Ossuario[]

  @@map("blocos")
}

model Ossuario {
  id          String        @id @default(cuid())
  blocoId     String
  numero      String
  status      StatusUnidade @default(DISPONIVEL)
  valor       Decimal       @db.Decimal(12, 2)
  observacoes String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  bloco      Bloco       @relation(fields: [blocoId], references: [id])
  vendaItens VendaItem[]

  @@unique([blocoId, numero])
  @@map("ossuarios")
}

// ============================================================
// PRODUTOS E SERVIÇOS (usados em vendas e atendimentos)
// ============================================================

model Produto {
  id        String   @id @default(cuid())
  nome      String
  descricao String?
  categoria String?
  valor     Decimal  @db.Decimal(12, 2)
  estoque   Int      @default(0)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendaItens       VendaItem[]
  atendimentoItens AtendimentoItem[]

  @@map("produtos")
}

model Servico {
  id        String   @id @default(cuid())
  nome      String
  descricao String?
  categoria String?
  valor     Decimal  @db.Decimal(12, 2)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendaItens       VendaItem[]
  atendimentoItens AtendimentoItem[]

  @@map("servicos")
}

// ============================================================
// MÓDULO: VENDAS (jazigos, columbários, ossuários, produtos, serviços)
// ============================================================

enum TipoVenda {
  JAZIGO
  COLUMBARIO
  OSSUARIO
  PRODUTO
  SERVICO
  PLANO
}

enum StatusVenda {
  ORCAMENTO
  CONFIRMADA
  CANCELADA
}

model Venda {
  id             String      @id @default(cuid())
  numero         String      @unique
  tipo           TipoVenda
  clienteId      String
  vendedorId     String?
  dataVenda      DateTime    @default(now())
  valorTotal     Decimal     @db.Decimal(12, 2)
  formaPagamento String?
  status         StatusVenda @default(ORCAMENTO)
  observacoes    String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  cliente  Pessoa         @relation("ClienteVendas", fields: [clienteId], references: [id])
  vendedor Usuario?       @relation("VendedorVendas", fields: [vendedorId], references: [id])
  itens    VendaItem[]
  parcelas VendaParcela[]

  @@map("vendas")
}

model VendaItem {
  id            String  @id @default(cuid())
  vendaId       String
  descricao     String
  jazigoId      String?
  columbarioId  String?
  ossuarioId    String?
  produtoId     String?
  servicoId     String?
  quantidade    Int     @default(1)
  valorUnitario Decimal @db.Decimal(12, 2)
  valorTotal    Decimal @db.Decimal(12, 2)

  venda      Venda       @relation(fields: [vendaId], references: [id], onDelete: Cascade)
  jazigo     Jazigo?     @relation(fields: [jazigoId], references: [id])
  columbario Columbario? @relation(fields: [columbarioId], references: [id])
  ossuario   Ossuario?   @relation(fields: [ossuarioId], references: [id])
  produto    Produto?    @relation(fields: [produtoId], references: [id])
  servico    Servico?    @relation(fields: [servicoId], references: [id])

  @@map("venda_itens")
}

model VendaParcela {
  id             String        @id @default(cuid())
  vendaId        String
  numeroParcela  Int
  valor          Decimal       @db.Decimal(12, 2)
  vencimento     DateTime
  dataPagamento  DateTime?
  formaPagamento String?
  status         StatusParcela @default(PENDENTE)

  venda Venda @relation(fields: [vendaId], references: [id], onDelete: Cascade)

  @@map("venda_parcelas")
}

// ============================================================
// MÓDULO: LOCAÇÕES (jazigos, salas comerciais, ortopédicos)
// ============================================================

enum TipoLocacao {
  JAZIGO
  SALA_COMERCIAL
  ORTOPEDICO
}

enum StatusLocacao {
  ATIVA
  ENCERRADA
  CANCELADA
}

enum PeriodicidadeLocacao {
  DIARIA
  SEMANAL
  MENSAL
}

model SalaComercial {
  id          String        @id @default(cuid())
  nome        String
  descricao   String?
  areaM2      Decimal?      @db.Decimal(10, 2)
  valorMensal Decimal       @db.Decimal(12, 2)
  status      StatusUnidade @default(DISPONIVEL)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  locacoes Locacao[]

  @@map("salas_comerciais")
}

model EquipamentoOrtopedico {
  id               String        @id @default(cuid())
  tipo             String
  codigoPatrimonio String?       @unique
  descricao        String?
  valorDiaria      Decimal       @db.Decimal(12, 2)
  status           StatusUnidade @default(DISPONIVEL)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  locacoes Locacao[]

  @@map("equipamentos_ortopedicos")
}

model Locacao {
  id                      String               @id @default(cuid())
  numero                  String               @unique
  tipo                    TipoLocacao
  clienteId               String
  jazigoId                String?
  salaComercialId         String?
  equipamentoOrtopedicoId String?
  dataInicio              DateTime             @default(now())
  dataFim                 DateTime?
  valor                   Decimal              @db.Decimal(12, 2)
  periodicidade           PeriodicidadeLocacao @default(MENSAL)
  status                  StatusLocacao        @default(ATIVA)
  observacoes             String?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  cliente               Pessoa                 @relation("ClienteLocacoes", fields: [clienteId], references: [id])
  jazigo                Jazigo?                @relation(fields: [jazigoId], references: [id])
  salaComercial         SalaComercial?         @relation(fields: [salaComercialId], references: [id])
  equipamentoOrtopedico EquipamentoOrtopedico? @relation(fields: [equipamentoOrtopedicoId], references: [id])
  parcelas              LocacaoParcela[]

  @@map("locacoes")
}

model LocacaoParcela {
  id             String        @id @default(cuid())
  locacaoId      String
  numeroParcela  Int
  valor          Decimal       @db.Decimal(12, 2)
  vencimento     DateTime
  dataPagamento  DateTime?
  formaPagamento String?
  status         StatusParcela @default(PENDENTE)

  locacao Locacao @relation(fields: [locacaoId], references: [id], onDelete: Cascade)

  @@map("locacao_parcelas")
}

// ============================================================
// MÓDULO: ATENDIMENTO FUNERÁRIO
// ============================================================

model Obito {
  id               String    @id @default(cuid())
  nomeFalecido     String
  cpfFalecido      String?
  dataNascimento   DateTime?
  dataFalecimento  DateTime
  localFalecimento String?
  causaMortis      String?
  numeroDO         String?
  responsavelId    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  responsavel  Pessoa?       @relation("ResponsavelObitos", fields: [responsavelId], references: [id])
  atendimentos Atendimento[]

  @@map("obitos")
}

enum TipoAtendimento {
  VELORIO_SEPULTAMENTO
  CREMACAO
  TRANSLADO
  OUTROS
}

enum StatusAtendimento {
  EM_ANDAMENTO
  CONCLUIDO
  CANCELADO
}

model Atendimento {
  id                   String            @id @default(cuid())
  numero               String            @unique
  obitoId              String?
  clienteResponsavelId String
  tipoAtendimento      TipoAtendimento   @default(VELORIO_SEPULTAMENTO)
  dataAtendimento      DateTime          @default(now())
  atendenteId          String?
  status               StatusAtendimento @default(EM_ANDAMENTO)
  observacoes          String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  obito              Obito?            @relation(fields: [obitoId], references: [id])
  clienteResponsavel Pessoa            @relation("ClienteAtendimentos", fields: [clienteResponsavelId], references: [id])
  atendente          Usuario?          @relation("AtendenteAtendimentos", fields: [atendenteId], references: [id])
  itens              AtendimentoItem[]

  @@map("atendimentos")
}

model AtendimentoItem {
  id            String  @id @default(cuid())
  atendimentoId String
  produtoId     String?
  servicoId     String?
  descricao     String
  quantidade    Int     @default(1)
  valorUnitario Decimal @db.Decimal(12, 2)
  valorTotal    Decimal @db.Decimal(12, 2)

  atendimento Atendimento @relation(fields: [atendimentoId], references: [id], onDelete: Cascade)
  produto     Produto?    @relation(fields: [produtoId], references: [id])
  servico     Servico?    @relation(fields: [servicoId], references: [id])

  @@map("atendimento_itens")
}

// ============================================================
// MÓDULO: GUIAS MÉDICAS (exames clínicos, laboratoriais e consultas)
// ============================================================

enum TipoPrestador {
  LABORATORIO
  CLINICA
  MEDICO
}

model Prestador {
  id            String        @id @default(cuid())
  nome          String
  cpfCnpj       String?
  tipo          TipoPrestador
  especialidade String?
  telefone      String?
  email         String?
  ativo         Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  guiasMedicas GuiaMedica[]

  @@map("prestadores")
}

enum TipoProcedimentoMedico {
  EXAME_LABORATORIAL
  EXAME_CLINICO
  CONSULTA
}

model ProcedimentoMedico {
  id     String                 @id @default(cuid())
  codigo String?
  nome   String
  tipo   TipoProcedimentoMedico
  valor  Decimal                @db.Decimal(12, 2)
  ativo  Boolean                @default(true)

  guiaMedicaItens GuiaMedicaItem[]

  @@map("procedimentos_medicos")
}

enum TipoGuia {
  EXAME
  CONSULTA
}

enum StatusGuia {
  EMITIDA
  UTILIZADA
  CANCELADA
  EXPIRADA
}

model GuiaMedica {
  id                String     @id @default(cuid())
  numero            String     @unique
  beneficiarioId    String
  contratoPlanoId   String?
  prestadorId       String
  tipoGuia          TipoGuia
  dataEmissao       DateTime   @default(now())
  dataValidade      DateTime?
  medicoSolicitante String?
  status            StatusGuia @default(EMITIDA)
  observacoes       String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  beneficiario  Pessoa           @relation("BeneficiarioGuias", fields: [beneficiarioId], references: [id])
  contratoPlano ContratoPlano?   @relation(fields: [contratoPlanoId], references: [id])
  prestador     Prestador        @relation(fields: [prestadorId], references: [id])
  itens         GuiaMedicaItem[]

  @@map("guias_medicas")
}

model GuiaMedicaItem {
  id                   String  @id @default(cuid())
  guiaMedicaId         String
  procedimentoMedicoId String
  quantidade           Int     @default(1)
  valorUnitario        Decimal @db.Decimal(12, 2)
  valorTotal           Decimal @db.Decimal(12, 2)

  guiaMedica         GuiaMedica         @relation(fields: [guiaMedicaId], references: [id], onDelete: Cascade)
  procedimentoMedico ProcedimentoMedico @relation(fields: [procedimentoMedicoId], references: [id])

  @@map("guia_medica_itens")
}
